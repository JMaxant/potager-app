# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://potager:potager@localhost:5432/potager?sslmode=disable
LISTEN_ADDR=:8080
LOG_LEVEL=info
POSTGRES_PASSWORD=potager

# Caddy (production). Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
# and escape every "$" as "$$" when pasting it here.
SITE_ADDRESS=localhost
BASIC_AUTH_USER=potager
BASIC_AUTH_HASH=
